[Unit]
Description=YangSpace .NET 10 Preview API
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=yangspace
Group=yangspace
WorkingDirectory=/srv/yangspace/current/api
# Bind Kestrel to loopback only; CT164 ingress is exclusively via local Nginx when approved.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5090
EnvironmentFile=/etc/yangspace/preview.env
ExecStart=/usr/bin/dotnet /srv/yangspace/current/api/YangSpace.Api.dll
Restart=on-failure
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yangspace /var/log/yangspace
UMask=0077
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
