# YangSpace production operator inventory (example only; DO NOT source as is).
# Sensitive values are injected from protected systemd credentials/environment
# at activation; never check real secrets into Git or process arguments.

ASPNETCORE_ENVIRONMENT=Production
Preview__Enabled=false
Preview__AllowRegistration=false
Admin__Enabled=false
AllowedHosts=yangspace.gndstore.eu

# Actual absolute path with a reviewed, migrated SQLite database. The app
# refuses Mode=ReadWriteCreate and will not auto-create this file.
# ConnectionStrings__Main=Data Source=/var/lib/yangspace/yangspace.db;Mode=ReadWrite

# The secret is 32 cryptographically random bytes, BASE64 encoded.
# It MUST be set only from an operator-protected environment at activation.
# Admin__GatewaySecret=<DO_NOT_STORE_IN_REPO>

# OFFLINE admin enrollment only; never set in the active service unit.
# YANGSPACE_OFFLINE_ADMIN_PROVISION=CONFIRMED
